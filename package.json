{
  "name": "joonhaim-github-io",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "python3 scripts/dev_server.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:html": "find . -type f -name '*.html' -not -path './.git/*' -not -path './node_modules/*' -not -path './static/includes/*' -print0 | xargs -0 htmlhint",
    "lint:js": "eslint \"**/*.js\"",
    "lint": "npm run format:check && npm run lint:html && npm run lint:js",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "htmlhint": "^1.0.0",
    "prettier": "^3.0.0"
  }
}
